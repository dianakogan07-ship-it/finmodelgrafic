# Скопируйте в .env и заполните. .env не коммитится.
POSTGRES_PASSWORD=
# длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
# первый администратор создаётся при старте, если его ещё нет
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
HTTP_PORT=80
# память calc-воркера: одна книга ~1,7 ГБ; при загрузке новой версии в памяти ненадолго две
CALC_MEM_LIMIT=4g
CALC_MAX_BOOKS=1
